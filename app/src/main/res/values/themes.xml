<?xml version="1.0" encoding="utf-8"?>
<!--
  An AppCompat parent is required because MainActivity hosts the per-app language override
  through AppCompatDelegate. Every colour beyond the window background comes from Compose.
-->
<resources>
    <style name="Theme.Rastreado" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
